# Contact form (Resend) — create a free key at https://resend.com
# The form works without these in dev, but won't send the email until they're set.
RESEND_API_KEY=
# Where messages are delivered (defaults to alexlar163@gmail.com)
CONTACT_TO=alexlar163@gmail.com
# Sender (From). Must belong to a domain verified in Resend. Production value:
#   CONTACT_FROM=Alex Largo <contacto@alexlargo.tech>
# Visitors' replies go to their own address (replyTo), not to this sender.
# Without a verified domain, Resend's onboarding sender only delivers to the account owner.
CONTACT_FROM=Alex Largo <contacto@alexlargo.tech>
# Key for the contact form's signed timestamp (HMAC; anti-spam minimum fill time).
# Any long random string, e.g. `openssl rand -base64 32`. If unset, RESEND_API_KEY
# (then the Vercel deployment id) is used as the key.
CONTACT_STAMP_SECRET=
# Canonical URL for metadata, sitemap and robots (defaults to https://alexlargo.tech)
NEXT_PUBLIC_SITE_URL=
